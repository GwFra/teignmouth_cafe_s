# ---------------------------------------------------------------------------
# Teignmouth Flat Whites — environment variables
# Copy this file to `.env.local` and fill in real values.
#
# Each variable is annotated with how it's stored in Vercel (checked in CI;
# see scripts/env-vars.mjs):
#   # @vercel secret   sensitive value, stored as a Vercel secret
#   # @vercel config   readable value, stored as a Vercel config variable
#   # @vercel local    local development only, never synced
# When a release adds a variable, its value is read from a GitHub Actions
# repository secret/variable of the same name and added to Vercel on deploy.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Create a project at https://neon.tech and copy the pooled connection string.
# Or, for the local Docker database (`npm run db:up`, see docker-compose.yml):
#   DATABASE_URL="postgres://postgres:postgres@db.localtest.me:5432/main"
# @vercel secret
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Neon Auth, managed Better Auth) ---------------------------------
# Users and sessions live in the `neon_auth` schema of the Neon branch, so each
# branch has its own Auth URL. Copy it from Neon Console → Branch → Auth.
# Google OAuth credentials are set there too (Settings → Auth → OAuth
# providers), with the Google redirect URI ${NEON_AUTH_BASE_URL}/callback/google.
# @vercel config
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.eu-west-2.aws.neon.tech/neondb/auth"

# Signs the session data cookie; at least 32 characters.
# Generate with: openssl rand -base64 32
# @vercel secret
NEON_AUTH_COOKIE_SECRET="change-me-to-a-long-random-string"

# Local development only: adds "Dev admin" / "Dev viewer" buttons that sign in
# without Google (the dev admin has the admin role). Only works under
# `next dev`; production builds ignore it. With this on, the Neon Auth
# variables above can be left unset when using the local Docker database.
# @vercel local
DEV_LOGIN="true"

# --- Google Maps -----------------------------------------------------------
# Maps JavaScript API key from Google Cloud (restrict it to your domain!).
# Enable both "Maps JavaScript API" and "Places API" on this key/project —
# the admin cafe dialog uses Places Autocomplete to look up a cafe's address
# and coordinates by name, which needs billing enabled on the project even
# within the free monthly quota.
# This one is exposed to the browser, so lock it down by HTTP referrer.
# @vercel config
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-js-api-key"
# Map ID (Cloud Console → Google Maps Platform → Map Management) — required
# for the map view's advanced markers. Falls back to the app's own Map ID
# (see src/lib/maps-config.ts) if unset.
# To style the map, link a Map Style to this Map ID in Cloud Console; the
# Maps JS API has no option to pass a style ID directly.
# @vercel config
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="9ddbb250ba06c14b01b0ec7f"
